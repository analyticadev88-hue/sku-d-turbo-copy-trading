# One-off mentor server payments (Whop). Students pay nothing — the mentor is
# billed in batches: every time SKUD_SERVER_PAY_THRESHOLD approved students are
# unpaid, the admin app shows a payment modal for that batch.
WHOP_PAYMENT_URL=https://whop.com/your-payment-link
SKUD_SERVER_PAY_PRICE_USD=13
SKUD_SERVER_PAY_THRESHOLD=30

# Supabase project authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Enable email/password auth and add your app URL + /dashboard to the Supabase allowed redirect URLs.

# Supabase Postgres. Percent-encode reserved characters in passwords (for example, # as %23).
# Use the transaction pooler URL for DATABASE_URL and session pooler URL for DIRECT_URL.
DATABASE_URL=postgresql://postgres.your-project:your_password%23@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:your_password%23@aws-0-region.pooler.supabase.com:5432/postgres

# MT5 student bridge. Keep these server-side; never prefix with NEXT_PUBLIC_.
SKUD_BRIDGE_URL=https://skud.toporapula.dev
SKUD_BRIDGE_KEY=your_skud_bridge_key
SKUD_DEFAULT_MENTOR_ID=mentor-skud-01
SKUD_ALLOW_DEMO_STUDENT_ENROLLMENT=false
SKUD_ALLOW_LIVE_STUDENT_ACCOUNTS=false
SKUD_MENTOR_SETUP_CODE=replace_with_a_separate_long_random_operator_code
SKUD_ACCESS_APPROVAL_CODE=use_a_different_long_random_approval_code
